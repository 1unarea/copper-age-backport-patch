{
  "schemaVersion": 1,
  "id": "copper_age_patch",
  "version": "0.1.3",
  "name": "Copper Age Backport Patch",
  "description": "Adds durability fix, armor and tool trims, Jade tooltips, Better Combat, and Create integration for Copper Age Backport.",
  "authors": [
    "lunarea",
    "aegeada"
  ],
  "contact": {
    "homepage": "https://github.com/aegeada/copper-age-backport-patch",
    "sources": "https://github.com/aegeada/copper-age-backport-patch"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.lunarea.copperagepatch.fabric.CopperAgePatchFabric"
    ],
    "waila": [
      "com.github.lunarea.copperagepatch.compat.jade.CopperAgeJadePlugin"
    ],
    "jei_mod_plugin": [
      "com.github.lunarea.copperagepatch.compat.jei.CopperAgeJeiPlugin"
    ]
  },
  "mixins": [
    "copper_age_patch.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.21.1",
    "copperagebackport": ">=0.1.0"
  },
  "suggests": {
    "jade": "*",
    "jei": "*",
    "emi": "*",
    "bettercombat": "*",
    "create": "*"
  },
  "custom": {
    "fabric:resource_load_order": {
      "after": ["copperagebackport"]
    }
  }
}
